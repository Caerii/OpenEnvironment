
# SemanticTerrain Environment Variables
# Copy this file to .env and fill in your API keys

# =============================================================================
# LLM Provider API Keys (at least one required)
# =============================================================================

# Cerebras LLM API Key
# Get your key from: https://console.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Together AI API Key  
# Get your key from: https://api.together.xyz/
TOGETHER_API_KEY=your_together_api_key_here

# Google Gemini API Key
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# Optional Configuration
# =============================================================================

# Default LLM Provider (if multiple keys are set)
# Options: cerebras, together, google
# LLM_PROVIDER=cerebras

# Default LLM Model
# Cerebras: llama3.1-8b, llama3.1-70b
# Together: meta-llama/Llama-3-8b-chat-hf, meta-llama/Llama-3-70b-chat-hf
# Google: gemini-pro, gemini-pro-vision
# LLM_MODEL=llama3.1-8b

# =============================================================================
# Server Configuration
# =============================================================================

# Server Port (default: 8000)
# PORT=8000

# Debug Mode (default: false)
# DEBUG=false

# Log Level (default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# =============================================================================
# Terrain Generation Configuration
# =============================================================================

# Default Terrain Resolution (default: 512)
# TERRAIN_RESOLUTION=512

# Default Seed (default: 42)
# DEFAULT_SEED=42

# =============================================================================
# File Storage Configuration
# =============================================================================

# Output directory for generated terrain images
# OUTPUT_DIR=outputs

# State file path
# STATE_FILE=terrain_state.json

# =============================================================================
# Notes
# =============================================================================
# - At least one LLM API key is required for semantic terrain generation
# - The system will try providers in order: Cerebras -> Together -> Google
# - If no API key is provided, the system will fall back to regex-based parsing
# - All other variables have sensible defaults and are optional
# - Never commit your .env file - it contains sensitive API keys

